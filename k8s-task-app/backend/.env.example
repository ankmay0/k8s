# Copy to .env and fill in real values. Do NOT commit .env.
# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
# Must be an address the BROWSER can reach that routes back to the backend.
# In the kind/k8s setup the app is served at http://localhost:30080 and nginx
# proxies /auth/ to the backend, so the callback goes through :30080 (NOT :5000,
# which is the backend's in-cluster ClusterIP port and is not exposed to the host).
# This value must also match the "Authorization callback URL" registered on the
# GitHub OAuth App (https://github.com/settings/developers).
GITHUB_CALLBACK_URL=http://localhost:30080/auth/github/callback
# Optional repository API analysis. Static analysis works without this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
